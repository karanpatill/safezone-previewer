---
import type { UiStrings } from '../i18n/ui';
import { PLATFORM_ORDER } from '../data/platforms';

interface Props { t: UiStrings['tool'] }
const { t } = Astro.props;

const layers = [
  { key: 'ui', color: '#ffffff' },
  { key: 'safe', color: 'var(--color-safe)' },
  { key: 'danger', color: 'var(--color-danger)' },
  { key: 'crop45', color: '#fbbf24' },
  { key: 'crop34', color: '#38bdf8' },
  { key: 'crop11', color: '#e2e8f0' },
  { key: 'thirds', color: '#6b7280' },
] as const;

const margins = [
  { key: 'top', max: 800 },
  { key: 'bottom', max: 900 },
  { key: 'left', max: 400 },
  { key: 'right', max: 400 },
] as const;
---

<safezone-previewer id="tool" data-i18n={JSON.stringify(t)} class="block">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-8">

    <!-- Stage -->
    <div class="min-w-0">
      <fieldset class="seg grid-cols-3 sm:grid-cols-6 mb-4">
        <legend class="sr-only">{t.sections.platform}</legend>
        {PLATFORM_ORDER.map((id) => (
          <label>
            <input type="radio" name="platform" value={id} checked={id === 'reels'} />
            <span>{t.platforms[id]}</span>
          </label>
        ))}
      </fieldset>

      <div class="sz-stage" data-ref="stage">
        <canvas data-ref="canvas" tabindex="0" role="img" aria-label={`${t.sections.platform}: 1080 × 1920`}></canvas>
        <div class="sz-empty">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink-3" aria-hidden="true"><path d="M12 15V4m0 0L8 8m4-4 4 4M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <p class="text-[15px] font-semibold text-ink">{t.dropTitle}</p>
          <p class="text-[12.5px] text-ink-2 max-w-[240px] leading-relaxed">{t.dropSub}</p>
          <button type="button" class="btn btn-primary mt-2" data-action="browse">{t.browse}</button>
        </div>
        <video data-ref="video" muted playsinline loop preload="auto" class="hidden"></video>
      </div>

      <div data-ref="videoBar" hidden class="mx-auto mt-3 flex items-center gap-3" style="width: min(100%, calc((100svh - 7rem) * 9 / 16)); min-width: 260px;">
        <button type="button" class="btn h-8 w-8 p-0" data-action="play" data-ref="playBtn" aria-label={t.video.pause}>
          <svg class="i-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12-7.5z"/></svg>
          <svg class="i-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.5 4.5h4v15h-4zm7 0h4v15h-4z"/></svg>
        </button>
        <input type="range" class="range flex-1" min="0" max="1000" value="0" data-ref="scrub" aria-label={t.video.scrub} />
        <span class="kbd tabular-nums w-[84px] text-right" data-ref="time">0:00 / 0:00</span>
      </div>

      <p class="kbd text-center mt-3 hidden sm:block">{t.hint}</p>
    </div>

    <!-- Controls -->
    <div class="space-y-4 min-w-0">

      <section class="panel p-4">
        <h3 class="eyebrow mb-3">{t.sections.media}</h3>
        <div class="sz-no-media flex items-center justify-between gap-3">
          <p class="text-[12.5px] text-ink-2 leading-snug">{t.dropSub}</p>
          <button type="button" class="btn shrink-0" data-action="browse">{t.browse}</button>
        </div>
        <div class="sz-has-media items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="text-[13px] text-ink truncate" data-ref="fileName"></p>
            <p class="kbd mt-0.5" data-ref="fileMeta"></p>
          </div>
          <div class="flex gap-1.5 shrink-0">
            <button type="button" class="btn" data-action="browse">{t.replace}</button>
            <button type="button" class="btn btn-ghost" data-action="remove">{t.remove}</button>
          </div>
        </div>
        <input type="file" accept="image/*,video/*" data-ref="file" class="sr-only" tabindex="-1" aria-hidden="true" />
      </section>

      <section class="panel p-4">
        <h3 class="eyebrow mb-2">{t.sections.layers}</h3>
        <div class="divide-y divide-line">
          {layers.map((l) => (
            <label class="switch">
              <span class="flex items-center gap-2.5">
                <span class="swatch" style={`background:${l.color}`}></span>
                {t.layers[l.key]}
              </span>
              <input type="checkbox" data-layer={l.key} checked={['ui', 'safe', 'danger'].includes(l.key)} />
            </label>
          ))}
        </div>
        <div class="pt-3 mt-1 border-t border-line">
          <div class="flex justify-between text-[12.5px] text-ink-2 mb-1">
            <label for="sz-opacity">{t.uiOpacity}</label>
            <span class="kbd tabular-nums" data-ref="uiOpacityValue">90%</span>
          </div>
          <input id="sz-opacity" type="range" class="range" min="0" max="100" step="5" value="90" data-ref="uiOpacity" />
        </div>
      </section>

      <section class="panel p-4" data-ref="marginsPanel" hidden>
        <h3 class="eyebrow mb-2">{t.sections.margins}</h3>
        {margins.map((m) => (
          <div class="py-1">
            <div class="flex justify-between text-[12.5px] text-ink-2 mb-0.5">
              <label for={`sz-m-${m.key}`}>{t.margins[m.key]}</label>
              <span class="kbd tabular-nums" data-ref={`margin-${m.key}`}></span>
            </div>
            <input id={`sz-m-${m.key}`} type="range" class="range" min="0" max={m.max} step="10" data-margin={m.key} />
          </div>
        ))}
      </section>

      <section class="panel p-4">
        <h3 class="eyebrow mb-3">{t.sections.framing}</h3>
        <fieldset class="seg grid-cols-2">
          <legend class="sr-only">{t.fit}</legend>
          <label><input type="radio" name="fit" value="cover" checked /><span>{t.fitCover}</span></label>
          <label><input type="radio" name="fit" value="contain" /><span>{t.fitContain}</span></label>
        </fieldset>
        <div class="mt-3">
          <div class="flex justify-between text-[12.5px] text-ink-2 mb-1">
            <label for="sz-zoom">{t.zoom}</label>
            <span class="kbd tabular-nums" data-ref="zoomValue">100%</span>
          </div>
          <div class="flex items-center gap-3">
            <input id="sz-zoom" type="range" class="range" min="50" max="400" step="1" value="100" data-ref="zoom" />
            <button type="button" class="btn h-8 px-2.5 text-[12px]" data-action="recenter">{t.recenter}</button>
          </div>
        </div>
      </section>

      <section class="panel p-4" aria-live="polite">
        <h3 class="eyebrow mb-3">{t.sections.inspector}</h3>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-[12.5px]">
          <dt class="text-ink-3">{t.readout.safeArea}</dt><dd class="kbd !text-ink text-right tabular-nums" data-ref="readSafe">—</dd>
          <dt class="text-ink-3">{t.readout.usable}</dt><dd class="kbd !text-ink text-right tabular-nums" data-ref="readUsable">—</dd>
          <dt class="text-ink-3">{t.readout.margins}</dt><dd class="kbd !text-ink text-right tabular-nums" data-ref="readMargins">—</dd>
          <dt class="text-ink-3">{t.readout.cursor}</dt><dd class="kbd !text-ink text-right tabular-nums" data-ref="readCursor">—</dd>
        </dl>
        <div class="mt-3 flex items-center gap-2.5 rounded-lg bg-canvas border border-line px-3 py-2.5 min-h-[40px]">
          <span class="sz-dot" data-ref="statusDot" data-state="idle"></span>
          <span class="text-[12.5px] text-ink-2 leading-snug" data-ref="readStatus">{t.status.idle}</span>
        </div>
        <p class="mt-3 text-[12px] leading-relaxed text-ink-3" data-ref="sourceNote">{t.source.measured}</p>
      </section>

      <section class="panel p-4">
        <h3 class="eyebrow mb-3">{t.sections.export}</h3>
        <div class="grid grid-cols-2 gap-2">
          <button type="button" class="btn btn-primary" data-action="frame">{t.actions.frame}</button>
          <button type="button" class="btn" data-action="template">{t.actions.template}</button>
          <button type="button" class="btn" data-action="copy">{t.actions.copy}</button>
          <button type="button" class="btn btn-ghost" data-action="reset">{t.actions.reset}</button>
        </div>
      </section>
    </div>
  </div>

  <div class="sz-toast" role="status" data-ref="toast"></div>
</safezone-previewer>

<script>
  import '../scripts/previewer/app';
</script>
