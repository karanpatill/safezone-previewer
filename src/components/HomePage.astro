---
import Layout from '../layouts/Layout.astro';
import SafeZonePreviewer from './SafeZonePreviewer.astro';
import AdBanner from './AdBanner.astro';
import { SITE, LOCALES, LOCALE_META, homePath, type Locale } from '../config/site';
import { ui } from '../i18n/ui';
import { CROPS, PLATFORMS, cropOffset, safeRect, usablePct, type PlatformId } from '../data/platforms';
import type { HomeContent } from '../data/home/types';
import { ID, OG_IMAGE, SOURCES, SOURCE_ORDER, abs, stripHtml } from '../config/seo';

interface Props { locale: Locale; content: HomeContent }
const { locale, content } = Astro.props;
const t = ui[locale];
const path = homePath(locale);
const alternates = Object.fromEntries(LOCALES.map((l) => [l, homePath(l)]));

const specRows: { id: PlatformId; name: string }[] = [
  { id: 'reels', name: 'Instagram Reels' },
  { id: 'tiktok', name: 'TikTok' },
  { id: 'shorts', name: 'YouTube Shorts' },
  { id: 'story', name: 'Instagram Stories' },
  { id: 'reelsAds', name: `Instagram ${t.tool.platforms.reelsAds}` },
];
const cropRows = [
  { label: '4:5', ...CROPS.crop45 },
  { label: '3:4', ...CROPS.crop34 },
  { label: '1:1', ...CROPS.crop11 },
];
const pageUrl = abs(path);
const workflow = content.sections.find((s) => s.id === 'workflow');
const steps = workflow?.blocks.flatMap((b) => ('ol' in b ? b.ol : [])) ?? [];
const updated = new Date(SITE.updated).toLocaleDateString(LOCALE_META[locale].htmlLang, { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${pageUrl}#app`,
    name: SITE.name,
    url: pageUrl,
    description: t.meta.description,
    inLanguage: LOCALE_META[locale].htmlLang,
    applicationCategory: 'MultimediaApplication',
    applicationSubCategory: 'Video layout checker',
    operatingSystem: 'Any (modern web browser)',
    browserRequirements: 'Requires JavaScript and HTML5 Canvas',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      ...(['reels', 'tiktok', 'shorts', 'story', 'reelsAds'] as const).map((id) => `${t.tool.platforms[id]}: ${safeRect(PLATFORMS[id].margins).w} × ${safeRect(PLATFORMS[id].margins).h} px`),
      t.tool.layers.crop45, t.tool.layers.crop34, t.tool.layers.crop11,
      t.tool.actions.frame, t.tool.actions.template, t.tool.actions.copy,
    ],
    image: abs(OG_IMAGE.path),
    author: { '@id': ID.person },
    publisher: { '@id': ID.org },
    isPartOf: { '@id': ID.website },
    datePublished: SITE.updated,
    dateModified: SITE.updated,
    citation: SOURCE_ORDER.map((k) => ({ '@type': 'CreativeWork', name: SOURCES[k].name, url: SOURCES[k].url, publisher: { '@type': 'Organization', name: SOURCES[k].publisher } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    inLanguage: LOCALE_META[locale].htmlLang,
    mainEntity: content.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: stripHtml(f.a) },
    })),
  },
  ...(workflow ? [{
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    '@id': `${pageUrl}#workflow`,
    name: workflow.title,
    description: stripHtml(workflow.lead ?? ''),
    inLanguage: LOCALE_META[locale].htmlLang,
    totalTime: 'PT2M',
    estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
    tool: [{ '@type': 'HowToTool', name: SITE.name, url: pageUrl }],
    supply: [{ '@type': 'HowToSupply', name: '1080 × 1920 (9:16) video, still frame or screenshot' }],
    step: steps.map((li, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: stripHtml(li.match(/<strong>(.*?)<\/strong>/)?.[1] ?? li).replace(/[.:]$/, ''),
      text: stripHtml(li),
      url: `${pageUrl}#workflow`,
    })),
  }] : []),
];
---

<Layout locale={locale} title={t.meta.title} description={t.meta.description} path={path} alternates={alternates} jsonLd={jsonLd}>
  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 pt-8 sm:pt-10">
    <div class="max-w-3xl">
      <p class="eyebrow flex items-center gap-2"><span class="sz-dot" data-state="safe"></span>{t.hero.eyebrow}</p>
      <h1 class="mt-4 text-[clamp(1.875rem,1.4rem+1.8vw,2.75rem)] font-semibold tracking-[-0.035em] leading-[1.05] text-balance">{t.hero.h1}</h1>
      <p class="mt-3 max-w-2xl text-[15px] sm:text-[16px] leading-relaxed text-ink-2 text-pretty">{t.hero.sub}</p>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 mt-6 sm:mt-8 scroll-mt-20" aria-label={t.nav.tool}>
    <SafeZonePreviewer t={t.tool} />
  </section>

  <div class="px-4 sm:px-6"><AdBanner slot={`home-top-${locale}`} label={t.ad} format="horizontal" /></div>

  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 grid gap-12 lg:grid-cols-[200px_minmax(0,1fr)]">
    <nav class="hidden lg:block" aria-label={content.toc}>
      <div class="sticky top-24">
        <p class="eyebrow mb-3">{content.toc}</p>
        <ul class="space-y-1.5 text-[13px] border-l border-line">
          {content.sections.map((s) => (
            <li><a href={`#${s.id}`} class="block -ml-px border-l border-transparent pl-3 py-0.5 text-ink-3 hover:text-ink hover:border-ink-2">{s.title}</a></li>
          ))}
          <li><a href="#faq" class="block -ml-px border-l border-transparent pl-3 py-0.5 text-ink-3 hover:text-ink hover:border-ink-2">{content.faqTitle}</a></li>
          <li><a href="#sources" class="block -ml-px border-l border-transparent pl-3 py-0.5 text-ink-3 hover:text-ink hover:border-ink-2">{content.sources.title}</a></li>
        </ul>
      </div>
    </nav>

    <article class="prose-sz max-w-[720px] min-w-0">
      <p class="kbd !text-[12px] mb-8">{t.content.updated}: <time datetime={SITE.updated}>{updated}</time></p>

      {content.sections.map((s, i) => (
        <section id={s.id} class="scroll-mt-24">
          <h2>{s.title}</h2>
          {s.lead && <p class="lead" set:html={s.lead} />}
          {s.blocks.map((b) => (
            'p' in b ? <p set:html={b.p} /> :
            'h3' in b ? <h3 set:html={b.h3} /> :
            'ul' in b ? <ul>{b.ul.map((li) => <li set:html={li} />)}</ul> :
            'ol' in b ? <ol>{b.ol.map((li) => <li set:html={li} />)}</ol> :
            'pre' in b ? <pre><code set:html={b.pre} /></pre> :
            b.table === 'specs' ? (
              <div class="table-wrap">
                <table>
                  <thead><tr>
                    <th>{t.content.tableHead.platform}</th><th>{t.content.tableHead.top}</th><th>{t.content.tableHead.bottom}</th>
                    <th>{t.content.tableHead.left}</th><th>{t.content.tableHead.right}</th><th>{t.content.tableHead.area}</th><th>{t.content.tableHead.usable}</th>
                  </tr></thead>
                  <tbody>
                    {specRows.map(({ id, name }) => {
                      const m = PLATFORMS[id].margins; const r = safeRect(m);
                      return <tr><td class="!text-ink whitespace-nowrap">{name}</td><td>{m.top}</td><td>{m.bottom}</td><td>{m.left}</td><td>{m.right}</td><td class="whitespace-nowrap">{r.w} × {r.h}</td><td>{usablePct(m)}%</td></tr>;
                    })}
                  </tbody>
                </table>
              </div>
            ) : (
              <div class="table-wrap">
                <table>
                  <thead><tr><th>{t.content.cropHead.crop}</th><th>{t.content.cropHead.size}</th><th>{t.content.cropHead.lost}</th><th>{t.content.cropHead.where}</th></tr></thead>
                  <tbody>
                    {cropRows.map((c, j) => (
                      <tr><td class="!text-ink">{c.label}</td><td class="whitespace-nowrap">{c.w} × {c.h}</td><td class="whitespace-nowrap">{cropOffset(c.h)} px</td><td class="!whitespace-normal min-w-[220px]">{content.cropWhere[j]}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          ))}
          {i === 2 && <AdBanner slot={`home-mid-${locale}`} label={t.ad} format="auto" />}
        </section>
      ))}

      <section id="faq" class="scroll-mt-24">
        <h2>{content.faqTitle}</h2>
        <div class="not-prose divide-y divide-line border-y border-line">
          {content.faqs.map((f) => (
            <details class="group py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-3.5 text-[15.5px] font-medium text-ink [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg class="shrink-0 text-ink-3 transition-transform duration-200 group-open:rotate-45" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
              </summary>
              <p class="pb-4 text-[15px] leading-relaxed text-ink-2" set:html={f.a} />
            </details>
          ))}
        </div>
      </section>

      <section id="sources" class="scroll-mt-24">
        <h2>{content.sources.title}</h2>
        <p set:html={content.sources.note} />
        <ul>
          {SOURCE_ORDER.map((k) => (
            <li><a href={SOURCES[k].url} rel="noopener">{SOURCES[k].name}</a> <span class="text-ink-3">— {SOURCES[k].publisher}</span></li>
          ))}
        </ul>
      </section>
    </article>
  </div>

  <div class="px-4 sm:px-6"><AdBanner slot={`home-bottom-${locale}`} label={t.ad} format="rectangle" /></div>
</Layout>
