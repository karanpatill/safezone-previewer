---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';
---

<Layout title={`Page not found — ${SITE.name}`} description="This page does not exist." path="/404/" noindex>
  <section class="mx-auto max-w-[560px] px-4 sm:px-6 py-28 text-center">
    <p class="kbd">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">This page is outside the safe zone</h1>
    <p class="mt-4 text-ink-2">The link may be old or mistyped.</p>
    <div class="mt-8 flex justify-center gap-2">
      <a href="/" class="btn btn-primary">Open the previewer</a>
      <a href="/blog/" class="btn">Read the guides</a>
    </div>
  </section>
</Layout>
