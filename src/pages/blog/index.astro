---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../config/site';

interface Post { url: string; frontmatter: { title: string; description: string; date: string } }
const posts = Object.values(import.meta.glob<Post>('./*.md', { eager: true }))
  .sort((a, b) => b.frontmatter.date.localeCompare(a.frontmatter.date) || a.frontmatter.title.localeCompare(b.frontmatter.title));
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout
  title={`Creator guides to safe zones and vertical video layout — ${SITE.name}`}
  description="In-depth guides to Instagram Reels, TikTok and YouTube Shorts safe zones, aspect ratios, feed crops and the layout mistakes that get vertical videos covered."
  path="/blog/"
>
  <section class="mx-auto max-w-[880px] px-4 sm:px-6 pt-12 sm:pt-16">
    <p class="eyebrow">Guides</p>
    <h1 class="mt-4 text-[clamp(1.875rem,1.3rem+2vw,2.625rem)] font-semibold tracking-[-0.03em] leading-[1.12]">Vertical video layout, measured</h1>
    <p class="mt-4 max-w-2xl text-[17px] leading-relaxed text-ink-2">Practical, pixel-level guides for editors, creators and social teams. Every number matches the presets in the previewer.</p>

    <ul class="mt-12 border-t border-line divide-y divide-line">
      {posts.map((p) => (
        <li>
          <a href={p.url + '/'} class="group grid gap-2 py-7 sm:grid-cols-[120px_1fr] sm:gap-8">
            <time class="kbd !text-[12px] pt-1" datetime={p.frontmatter.date}>{fmt(p.frontmatter.date)}</time>
            <div>
              <h2 class="text-[18px] font-semibold tracking-tight group-hover:text-accent transition-colors">{p.frontmatter.title}</h2>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-2">{p.frontmatter.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
